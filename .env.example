# Root .env for `docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d`
# Copy this to `.env` in the repo root and fill in real values before deploying.
# Never commit the filled-in `.env` file.

# --- Domains ---
# Public URL of the deployed backend / frontend (used for links in emails, CORS, etc.)
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# --- Postgres ---
POSTGRES_USER=dkp_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dkp_db
# Only needed if you're pointing at a managed DB instead of the postgres container:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Auth ---
# Long random string — e.g. `openssl rand -base64 48`
JWT_SECRET=change-me

# --- Google OAuth (Sign in with Google) ---
# Only the Client ID is needed — this app verifies Google access tokens
# server-side (tokeninfo + userinfo), it does NOT do an authorization-code
# exchange, so GOOGLE_CLIENT_SECRET is never used anywhere in this codebase.
#
# Setup:
#   1. https://console.cloud.google.com -> APIs & Services -> Credentials
#   2. Open your OAuth 2.0 Client ID (Web application)
#   3. Add BOTH of these to "Authorized JavaScript origins":
#        http://localhost:3000        (local dev)
#        https://yourdomain.com       (your real deploy domain, no trailing slash)
#   4. Copy the Client ID and paste it in BOTH vars below (must match exactly)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_ID=your-google-client-id-here

# --- MinIO / S3 ---
MINIO_ROOT_USER=dkp_minio_user
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET_NAME=dkp-files
