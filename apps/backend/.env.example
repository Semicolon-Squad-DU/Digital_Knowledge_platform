PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL) — shared Supabase instance. Ask the team lead for
# the real connection string; do not point this at a local Postgres unless
# you know you need an isolated copy.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres

# Redis (local, via docker-compose)
REDIS_URL=redis://localhost:6379

# Elasticsearch (local, via docker-compose)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Supabase Storage (S3-compatible) — shared bucket for the whole team.
# The backend only reads these S3_* names (see core/config/index.ts).
# There is no local MinIO fallback anymore — ask the team lead for these
# values rather than reusing any old AWS_*/MinIO credentials you may have.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=dkp-files
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true
S3_CAPACITY_GB=50

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP / Email Alerts (local, via docker-compose mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dkp.local
